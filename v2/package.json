{
	"name": "action-code-review-v2",
	"version": "2.0.0",
	"description": "V2 AI code review engine: repository-aware review via a coding harness over an OpenAI-compatible endpoint",
	"type": "module",
	"main": "dist/cli.js",
	"scripts": {
		"build": "tsc",
		"test": "vitest run",
		"test:watch": "vitest",
		"test:coverage": "vitest run --coverage",
		"lint": "biome check src/ tests/",
		"lint:fix": "biome check --apply src/ tests/",
		"format": "biome format --write src/ tests/",
		"typecheck": "tsc --noEmit"
	},
	"keywords": [
		"github-action",
		"code-review",
		"openai-compatible",
		"pull-request"
	],
	"author": "niko0xdev",
	"license": "MIT",
	"dependencies": {
		"@actions/core": "^1.10.1",
		"@actions/github": "^5.1.1"
	},
	"devDependencies": {
		"@biomejs/biome": "^1.4.1",
		"@types/node": "^20.10.0",
		"@vitest/coverage-v8": "^1.0.4",
		"typescript": "^5.3.2",
		"vitest": "^1.0.4",
		"yaml": "^2.9.0"
	},
	"packageManager": "pnpm@10.22.0+sha512.bf049efe995b28f527fd2b41ae0474ce29186f7edcb3bf545087bd61fbbebb2bf75362d1307fda09c2d288e1e499787ac12d4fcb617a974718a6051f2eee741c"
}
