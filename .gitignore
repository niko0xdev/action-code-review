# Dependencies
node_modules/
npm-debug.log*

# Build output
lib/

# IDE
.vscode/
.idea/

# OS
.DS_Store
Thumbs.db

# Logs
*.log

# Environment variables
.env
.env.local

# Test coverage
coverage/

# Temporary files
*.tmp
*.temp
examples/nextjs/.next/
.aider*

# V2 build output (rebuilt from source with pnpm build).
# Ignore the entire v2/dist tree EXCEPT v2/dist/entry/ — entry bundles MUST
# be committed so the delegation bridge can find them at runtime without
# requiring a build step in the consumer's checkout. These are the actual
# entry points invoked via runViaV2IfAvailable() in
# pr-review/src/v2Delegate.ts and pr-content/src/v2Delegate.ts.
v2/dist/*
!v2/dist/entry/
