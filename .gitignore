# Dependencies
node_modules/
npm-debug.log*

# Build output
lib/

# IDE
.vscode/
.idea/

# OS
.DS_Store
Thumbs.db

# Logs
*.log

# Environment variables
.env
.env.local

# Test coverage
coverage/

# Temporary files
*.tmp
*.temp
examples/nextjs/.next/
.aider*

# V2 build output (rebuilt from source with pnpm build).
# v2/dist/ entry/ and cli.js MUST be committed so the delegation bridge can
# find them without requiring a build step in the consumer's checkout.
# - v2/dist/entry/ holds the entry bundles invoked via
#   runViaV2IfAvailable() in pr-review/src/v2Delegate.ts and
#   pr-content/src/v2Delegate.ts.
# - v2/dist/cli.js is the transitive import of those entries.
v2/dist/*
!v2/dist/entry/
!v2/dist/cli.js
